<mujoco model="three_finger_gripper">

    <compiler inertiafromgeom="true"/>

    <option timestep="0.002"
            gravity="0 0 -9.81"/>

    <visual>
        <headlight ambient="0.5 0.5 0.5"
                   diffuse="0.8 0.8 0.8"
                   specular="0.2 0.2 0.2"/>
    </visual>


    <worldbody>

        <geom name="floor"
              type="plane"
              size="3 3 0.1"
              friction="1 0.005 0.0001"/>

        <light name="light"
               pos="0 -1 3"/>

        <camera name="camera"
                pos="0 -1 0.8"
                xyaxes="1 0 0 0 0 1"/>


        <body name="table"
              pos="0 0 0.3">

            <geom name="table_top"
                  type="box"
                  size="0.4 0.4 0.02"
                  rgba="0.5 0.3 0.2 1"/>

        </body>


        <body name="gripper"
              pos="0 0 0.7">

            <geom name="base"
                  type="box"
                  size="0.15 0.15 0.05"
                  rgba="0.25 0.25 0.25 1"/>


            <body name="left_finger"
                  pos="-0.12 0 0">

                <joint name="left_slide"
                       type="slide"
                       axis="1 0 0"
                       range="-0.08 0.08"/>

                <geom name="left_pad"
                      type="box"
                      size="0.02 0.05 0.1"
                      mass="0.2"
                      friction="1 0.005 0.0001"/>

            </body>


            <body name="right_finger"
                  pos="0.12 0 0">

                <joint name="right_slide"
                       type="slide"
                       axis="1 0 0"
                       range="-0.08 0.08"/>

                <geom name="right_pad"
                      type="box"
                      size="0.02 0.05 0.1"
                      mass="0.2"
                      friction="1 0.005 0.0001"/>

            </body>


            <body name="top_finger"
                  pos="0 0 0.18">

                <joint name="top_slide"
                       type="slide"
                       axis="0 0 1"
                       range="-0.12 0.12"/>

                <geom name="top_pad"
                      type="box"
                      size="0.05 0.05 0.02"
                      mass="0.2"
                      friction="1 0.005 0.0001"/>

            </body>

        </body>


        <body name="object"
              pos="0 0 0.9">

            <joint name="free"
                   type="free"/>

            <geom name="cube"
                  type="box"
                  size="0.025 0.025 0.025"
                  mass="0.1"
                  friction="0.8 0.005 0.0001"/>

        </body>


    </worldbody>


    <actuator>

        <position joint="left_slide"
                  kp="200"/>

        <position joint="right_slide"
                  kp="200"/>

        <position joint="top_slide"
                  kp="200"/>

    </actuator>


</mujoco>